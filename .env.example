# קובץ לדוגמה - זה כן עולה ל-GitHub, כדי שנדע אילו משתנים צריך.
# את הערכים האמיתיים שמים רק ב-.env.local (קובץ שלא עולה ל-GitHub).

# ===== Supabase (מסד נתונים + התחברות + אחסון תמונות) =====
# נמצא ב: Project Settings -> API, אחרי שניצור פרויקט ב-supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# מפתח סודי! לשימוש בצד השרת בלבד, אף פעם לא בדפדפן.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Mapbox (מפות) =====
# נמצא ב: Account -> Tokens, אחרי שניצור חשבון ב-mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=
