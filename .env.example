# קובץ לדוגמה - זה כן עולה ל-GitHub, כדי שנדע אילו משתנים צריך.
# את הערכים האמיתיים שמים רק ב-.env.local (קובץ שלא עולה ל-GitHub).

# ===== Supabase (מסד נתונים + התחברות בלבד - לא לתמונות) =====
# נמצא ב: Project Settings -> API, אחרי שניצור פרויקט ב-supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# מפתח סודי! לשימוש בצד השרת בלבד, אף פעם לא בדפדפן.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Mapbox (מפות) =====
# נמצא ב: Account -> Tokens, אחרי שניצור חשבון ב-mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=

# ===== Cloudinary (אחסון תמונות/וידאו של הדירות) =====
# נמצא ב: Dashboard הראשי ב-cloudinary.com (מוצג שם "Cloud name")
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# נמצא ב: Settings -> Upload -> Upload presets (ניצור preset מסוג "Unsigned")
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
